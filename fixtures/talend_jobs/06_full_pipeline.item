<?xml version="1.0" encoding="UTF-8"?>
<xmi:XMI xmlns:xmi="http://www.omg.org/XMI" xmlns:talendfile="platform:/resource/org.talend.model/model/TalendFile.xsd">
  <talendfile:ProcessItem>
    <process>
      <!-- Source 1: raw_orders -->
      <node componentName="tMysqlInput" offsetLabelX="0" offsetLabelY="0" posX="64" posY="64">
        <elementParameter field="TEXT" name="UNIQUE_NAME" value="tMysqlInput_1"/>
        <elementParameter field="TEXT" name="DBNAME" value="&quot;jaffle_shop&quot;"/>
        <elementParameter field="TEXT" name="TABLE" value="&quot;raw_orders&quot;"/>
        <elementParameter field="TEXT" name="QUERY" value="&quot;SELECT * FROM raw_orders&quot;"/>
        <metadata name="tMysqlInput_1">
          <column name="id" type="id_Integer" key="true" nullable="false"/>
          <column name="user_id" type="id_Integer" nullable="false"/>
          <column name="order_date" type="id_Date" nullable="true"/>
          <column name="status" type="id_String" length="32" nullable="true"/>
          <column name="amount" type="id_Integer" nullable="true"/>
        </metadata>
      </node>

      <!-- Source 2: raw_payments (lookup) -->
      <node componentName="tMysqlInput" offsetLabelX="0" offsetLabelY="0" posX="64" posY="256">
        <elementParameter field="TEXT" name="UNIQUE_NAME" value="tMysqlInput_2"/>
        <elementParameter field="TEXT" name="DBNAME" value="&quot;jaffle_shop&quot;"/>
        <elementParameter field="TEXT" name="TABLE" value="&quot;raw_payments&quot;"/>
        <elementParameter field="TEXT" name="QUERY" value="&quot;SELECT * FROM raw_payments&quot;"/>
        <metadata name="tMysqlInput_2">
          <column name="id" type="id_Integer" key="true" nullable="false"/>
          <column name="order_id" type="id_Integer" nullable="false"/>
          <column name="payment_method" type="id_String" length="32" nullable="true"/>
          <column name="amount" type="id_Integer" nullable="true"/>
        </metadata>
      </node>

      <!-- tMap: join orders + payments -->
      <node componentName="tMap" offsetLabelX="0" offsetLabelY="0" posX="320" posY="128">
        <elementParameter field="TEXT" name="UNIQUE_NAME" value="tMap_1"/>
        <nodeData xsi:type="TalendMapper:MapperData" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
          <inputTables name="row1">
            <mapperTableEntries name="id"/>
            <mapperTableEntries name="user_id"/>
            <mapperTableEntries name="status"/>
            <mapperTableEntries name="amount"/>
          </inputTables>
          <inputTables name="row2" innerJoin="true" matchingMode="ALL_MATCHES">
            <mapperTableEntries name="order_id" expression="row1.id"/>
            <mapperTableEntries name="payment_method"/>
            <mapperTableEntries name="amount"/>
          </inputTables>
          <outputTables name="out1">
            <mapperTableEntries name="order_id" expression="row1.id" type="id_Integer"/>
            <mapperTableEntries name="user_id" expression="row1.user_id" type="id_Integer"/>
            <mapperTableEntries name="order_status" expression="row1.status" type="id_String"/>
            <mapperTableEntries name="payment_method" expression="StringHandling.UPCASE(row2.payment_method)" type="id_String"/>
            <mapperTableEntries name="payment_amount" expression="row2.amount / 100.0" type="id_Double"/>
          </outputTables>
        </nodeData>
      </node>

      <!-- tAggregateRow: sum payments by order + method -->
      <node componentName="tAggregateRow" offsetLabelX="0" offsetLabelY="0" posX="512" posY="128">
        <elementParameter field="TEXT" name="UNIQUE_NAME" value="tAggregateRow_1"/>
        <elementParameter field="TABLE" name="GROUP_BY">
          <elementValue elementRef="INPUT_COLUMN" value="order_id"/>
          <elementValue elementRef="OUTPUT_COLUMN" value="order_id"/>
        </elementParameter>
        <elementParameter field="TABLE" name="GROUP_BY">
          <elementValue elementRef="INPUT_COLUMN" value="user_id"/>
          <elementValue elementRef="OUTPUT_COLUMN" value="user_id"/>
        </elementParameter>
        <elementParameter field="TABLE" name="GROUP_BY">
          <elementValue elementRef="INPUT_COLUMN" value="order_status"/>
          <elementValue elementRef="OUTPUT_COLUMN" value="order_status"/>
        </elementParameter>
        <elementParameter field="TABLE" name="OPERATIONS">
          <elementValue elementRef="INPUT_COLUMN" value="payment_amount"/>
          <elementValue elementRef="FUNCTION" value="sum"/>
          <elementValue elementRef="OUTPUT_COLUMN" value="total_paid"/>
        </elementParameter>
        <elementParameter field="TABLE" name="OPERATIONS">
          <elementValue elementRef="INPUT_COLUMN" value="payment_amount"/>
          <elementValue elementRef="FUNCTION" value="count"/>
          <elementValue elementRef="OUTPUT_COLUMN" value="num_payments"/>
        </elementParameter>
      </node>

      <!-- Target: order_payment_summary -->
      <node componentName="tMysqlOutput" offsetLabelX="0" offsetLabelY="0" posX="704" posY="128">
        <elementParameter field="TEXT" name="UNIQUE_NAME" value="tMysqlOutput_1"/>
        <elementParameter field="TEXT" name="DBNAME" value="&quot;jaffle_shop&quot;"/>
        <elementParameter field="TEXT" name="TABLE" value="&quot;order_payment_summary&quot;"/>
        <elementParameter field="TEXT" name="ACTION_ON_TABLE" value="DROP_CREATE"/>
        <elementParameter field="TEXT" name="ACTION_ON_DATA" value="INSERT"/>
        <metadata name="tMysqlOutput_1">
          <column name="order_id" type="id_Integer" key="true" nullable="false"/>
          <column name="user_id" type="id_Integer" nullable="false"/>
          <column name="order_status" type="id_String" length="32" nullable="true"/>
          <column name="total_paid" type="id_Double" nullable="true"/>
          <column name="num_payments" type="id_Integer" nullable="true"/>
        </metadata>
      </node>

      <!-- Data flow -->
      <connection connectorName="FLOW" label="row1" lineStyle="0"
          metaname="tMysqlInput_1" source="tMysqlInput_1" target="tMap_1"/>
      <connection connectorName="FLOW" label="row2" lineStyle="0"
          metaname="tMysqlInput_2" source="tMysqlInput_2" target="tMap_1"/>
      <connection connectorName="FLOW" label="out1" lineStyle="0"
          metaname="tMap_1" source="tMap_1" target="tAggregateRow_1"/>
      <connection connectorName="FLOW" label="row3" lineStyle="0"
          metaname="tAggregateRow_1" source="tAggregateRow_1" target="tMysqlOutput_1"/>
    </process>
  </talendfile:ProcessItem>
</xmi:XMI>
