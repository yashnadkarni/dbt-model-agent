<?xml version="1.0" encoding="UTF-8"?>
<xmi:XMI xmlns:xmi="http://www.omg.org/XMI" xmlns:talendfile="platform:/resource/org.talend.model/model/TalendFile.xsd">
  <talendfile:ProcessItem>
    <process>
      <!-- Source 1: raw_orders -->
      <node componentName="tMysqlInput" offsetLabelX="0" offsetLabelY="0" posX="64" posY="64">
        <elementParameter field="TEXT" name="UNIQUE_NAME" value="tMysqlInput_1"/>
        <elementParameter field="TEXT" name="DBNAME" value="&quot;jaffle_shop&quot;"/>
        <elementParameter field="TEXT" name="TABLE" value="&quot;raw_orders&quot;"/>
        <elementParameter field="TEXT" name="QUERY" value="&quot;SELECT * FROM raw_orders&quot;"/>
        <metadata name="tMysqlInput_1">
          <column name="id" type="id_Integer" key="true" nullable="false"/>
          <column name="user_id" type="id_Integer" nullable="false"/>
          <column name="order_date" type="id_Date" nullable="true"/>
          <column name="status" type="id_String" length="32" nullable="true"/>
          <column name="amount" type="id_Integer" nullable="true"/>
        </metadata>
      </node>

      <!-- Source 2: raw_customers (lookup) -->
      <node componentName="tMysqlInput" offsetLabelX="0" offsetLabelY="0" posX="64" posY="256">
        <elementParameter field="TEXT" name="UNIQUE_NAME" value="tMysqlInput_2"/>
        <elementParameter field="TEXT" name="DBNAME" value="&quot;jaffle_shop&quot;"/>
        <elementParameter field="TEXT" name="TABLE" value="&quot;raw_customers&quot;"/>
        <elementParameter field="TEXT" name="QUERY" value="&quot;SELECT * FROM raw_customers&quot;"/>
        <metadata name="tMysqlInput_2">
          <column name="id" type="id_Integer" key="true" nullable="false"/>
          <column name="first_name" type="id_String" length="64" nullable="true"/>
          <column name="last_name" type="id_String" length="64" nullable="true"/>
        </metadata>
      </node>

      <!-- tMap: join orders + customers, rename columns -->
      <node componentName="tMap" offsetLabelX="0" offsetLabelY="0" posX="320" posY="128">
        <elementParameter field="TEXT" name="UNIQUE_NAME" value="tMap_1"/>
        <nodeData xsi:type="TalendMapper:MapperData" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
          <!-- Main input: orders -->
          <inputTables name="row1">
            <mapperTableEntries name="id"/>
            <mapperTableEntries name="user_id"/>
            <mapperTableEntries name="order_date"/>
            <mapperTableEntries name="status"/>
            <mapperTableEntries name="amount"/>
          </inputTables>
          <!-- Lookup: customers (LEFT JOIN on row1.user_id = row2.id) -->
          <inputTables name="row2" innerJoin="false" matchingMode="FIRST_MATCH">
            <mapperTableEntries name="id" expression="row1.user_id"/>
            <mapperTableEntries name="first_name"/>
            <mapperTableEntries name="last_name"/>
          </inputTables>
          <!-- Output: joined + renamed columns -->
          <outputTables name="out1">
            <mapperTableEntries name="order_id" expression="row1.id" type="id_Integer"/>
            <mapperTableEntries name="customer_id" expression="row1.user_id" type="id_Integer"/>
            <mapperTableEntries name="customer_name" expression="row2.first_name + &quot; &quot; + row2.last_name" type="id_String"/>
            <mapperTableEntries name="order_date" expression="row1.order_date" type="id_Date"/>
            <mapperTableEntries name="status" expression="row1.status" type="id_String"/>
            <mapperTableEntries name="amount_dollars" expression="row1.amount / 100.0" type="id_Double"/>
          </outputTables>
        </nodeData>
      </node>

      <!-- Filter: only completed orders -->
      <node componentName="tFilterRow" offsetLabelX="0" offsetLabelY="0" posX="512" posY="128">
        <elementParameter field="TEXT" name="UNIQUE_NAME" value="tFilterRow_1"/>
        <elementParameter field="TABLE" name="CONDITIONS">
          <elementValue elementRef="INPUT_COLUMN" value="status"/>
          <elementValue elementRef="FUNCTION" value=""/>
          <elementValue elementRef="OPERATOR" value="=="/>
          <elementValue elementRef="RVALUE" value="&quot;completed&quot;"/>
        </elementParameter>
      </node>

      <!-- Target: completed_order_details -->
      <node componentName="tMysqlOutput" offsetLabelX="0" offsetLabelY="0" posX="704" posY="128">
        <elementParameter field="TEXT" name="UNIQUE_NAME" value="tMysqlOutput_1"/>
        <elementParameter field="TEXT" name="DBNAME" value="&quot;jaffle_shop&quot;"/>
        <elementParameter field="TEXT" name="TABLE" value="&quot;completed_order_details&quot;"/>
        <elementParameter field="TEXT" name="ACTION_ON_TABLE" value="DROP_CREATE"/>
        <elementParameter field="TEXT" name="ACTION_ON_DATA" value="INSERT"/>
        <metadata name="tMysqlOutput_1">
          <column name="order_id" type="id_Integer" key="true" nullable="false"/>
          <column name="customer_id" type="id_Integer" nullable="false"/>
          <column name="customer_name" type="id_String" length="128" nullable="true"/>
          <column name="order_date" type="id_Date" nullable="true"/>
          <column name="status" type="id_String" length="32" nullable="true"/>
          <column name="amount_dollars" type="id_Double" nullable="true"/>
        </metadata>
      </node>

      <!-- Data flow connections -->
      <connection connectorName="FLOW" label="row1" lineStyle="0"
          metaname="tMysqlInput_1" offsetLabelX="0" offsetLabelY="0"
          source="tMysqlInput_1" target="tMap_1"/>
      <connection connectorName="FLOW" label="row2" lineStyle="0"
          metaname="tMysqlInput_2" offsetLabelX="0" offsetLabelY="0"
          source="tMysqlInput_2" target="tMap_1"/>
      <connection connectorName="FLOW" label="out1" lineStyle="0"
          metaname="tMap_1" offsetLabelX="0" offsetLabelY="0"
          source="tMap_1" target="tFilterRow_1"/>
      <connection connectorName="FLOW" label="row3" lineStyle="0"
          metaname="tFilterRow_1" offsetLabelX="0" offsetLabelY="0"
          source="tFilterRow_1" target="tMysqlOutput_1"/>
    </process>
  </talendfile:ProcessItem>
</xmi:XMI>
