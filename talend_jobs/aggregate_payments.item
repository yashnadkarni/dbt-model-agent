<?xml version="1.0" encoding="UTF-8"?>
<!--
  Talend Job: aggregate_payments
  
  Pipeline: tMysqlInput → tMap (rename + transform) → tAggregateRow → tMysqlOutput
  
  Purpose: Read raw_payments, rename columns and convert amount from
           cents to dollars, then aggregate by payment_method to produce
           a summary table with total amount and transaction count per method.
-->
<xmi:XMI xmi:version="2.0"
  xmlns:xmi="http://www.omg.org/XMI"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xmlns:talendfile="platform:/resource/org.talend.model/model/TalendFile.xsd"
  xmlns:TalendMapper="http://www.talend.org/mapper">

  <talendfile:ProcessItem>
    <process defaultContext="Default">

      <context name="Default">
        <contextParameter name="db_host" type="id_String" value="localhost"/>
        <contextParameter name="db_port" type="id_String" value="3306"/>
        <contextParameter name="db_name" type="id_String" value="jaffle_shop"/>
      </context>

      <!-- ============================================================
           NODE 1: tMysqlInput_1 — SOURCE (payments)
           ============================================================ -->
      <node componentName="tMysqlInput" componentVersion="0.102"
            posX="64" posY="160">
        <elementParameter field="TEXT" name="UNIQUE_NAME" value="tMysqlInput_1"/>
        <elementParameter field="TEXT" name="HOST" value="context.db_host"/>
        <elementParameter field="TEXT" name="DBNAME" value="&quot;jaffle_shop&quot;"/>
        <elementParameter field="TEXT" name="TABLE" value="&quot;raw_payments&quot;"/>
        <elementParameter field="MEMO_SQL" name="QUERY"
          value="&quot;SELECT id, order_id, payment_method, amount FROM raw_payments&quot;"/>
        <metadata connector="FLOW" name="tMysqlInput_1">
          <column name="id" key="true" nullable="false" type="id_Integer"/>
          <column name="order_id" nullable="false" type="id_Integer"/>
          <column name="payment_method" nullable="true" length="50" type="id_String"/>
          <column name="amount" nullable="true" type="id_Integer" comment="Amount in cents"/>
        </metadata>
      </node>

      <!-- ============================================================
           NODE 2: tMap_1 — COLUMN MAPPING + TRANSFORM
           
           This tMap does NOT do a join (only 1 input table).
           It does column renaming and expression-based transformations:
             - id → payment_id  (rename)
             - amount → amount_dollars  (divide by 100, change type)
             - payment_method: apply UPCASE
           ============================================================ -->
      <node componentName="tMap" componentVersion="0.102"
            posX="288" posY="160">
        <elementParameter field="TEXT" name="UNIQUE_NAME" value="tMap_1"/>
        <nodeData xsi:type="TalendMapper:MapperData">

          <inputTables name="row1" sizeState="0" matchingMode="ALL_ROWS">
            <mapperTableEntries name="id" expression="" type="id_Integer"/>
            <mapperTableEntries name="order_id" expression="" type="id_Integer"/>
            <mapperTableEntries name="payment_method" expression="" type="id_String"/>
            <mapperTableEntries name="amount" expression="" type="id_Integer"/>
          </inputTables>

          <outputTables name="out1" sizeState="0">
            <mapperTableEntries name="payment_id" expression="row1.id" type="id_Integer"/>
            <mapperTableEntries name="order_id" expression="row1.order_id" type="id_Integer"/>
            <mapperTableEntries name="payment_method"
              expression="StringHandling.UPCASE(row1.payment_method)"
              type="id_String"/>
            <mapperTableEntries name="amount_dollars"
              expression="row1.amount / 100.0"
              type="id_Double"/>
          </outputTables>

        </nodeData>
      </node>

      <!-- ============================================================
           NODE 3: tAggregateRow_1 — AGGREGATION
           
           This is Talend's GROUP BY component. It has two key params:
           
           GROUP_BY: Columns to group by. Each entry has:
             - INPUT_COLUMN: source column name
             - OUTPUT_COLUMN: output column name (usually the same)
           
           OPERATIONS: Aggregate functions to apply. Each entry has:
             - INPUT_COLUMN: column to aggregate
             - FUNCTION: sum, count, min, max, avg, first, last, etc.
             - OUTPUT_COLUMN: name for the computed result
           
           Note: You can have multiple GROUP_BY columns and
           multiple OPERATIONS — just add more <elementValue> pairs.
           ============================================================ -->
      <node componentName="tAggregateRow" componentVersion="0.102"
            posX="512" posY="160">
        <elementParameter field="TEXT" name="UNIQUE_NAME" value="tAggregateRow_1"/>
        <elementParameter field="TABLE" name="GROUP_BY">
          <elementValue elementRef="INPUT_COLUMN" value="payment_method"/>
          <elementValue elementRef="OUTPUT_COLUMN" value="payment_method"/>
        </elementParameter>
        <elementParameter field="TABLE" name="OPERATIONS">
          <elementValue elementRef="INPUT_COLUMN" value="amount_dollars"/>
          <elementValue elementRef="FUNCTION" value="sum"/>
          <elementValue elementRef="OUTPUT_COLUMN" value="total_amount"/>
        </elementParameter>
        <elementParameter field="TABLE" name="OPERATIONS">
          <elementValue elementRef="INPUT_COLUMN" value="payment_id"/>
          <elementValue elementRef="FUNCTION" value="count"/>
          <elementValue elementRef="OUTPUT_COLUMN" value="transaction_count"/>
        </elementParameter>
        <metadata connector="FLOW" name="tAggregateRow_1">
          <column name="payment_method" nullable="true" length="50" type="id_String"/>
          <column name="total_amount" nullable="true" type="id_Double"/>
          <column name="transaction_count" nullable="true" type="id_Long"/>
        </metadata>
      </node>

      <!-- ============================================================
           NODE 4: tMysqlOutput_1 — TARGET (payment_summary)
           ============================================================ -->
      <node componentName="tMysqlOutput" componentVersion="0.102"
            posX="736" posY="160">
        <elementParameter field="TEXT" name="UNIQUE_NAME" value="tMysqlOutput_1"/>
        <elementParameter field="TEXT" name="HOST" value="context.db_host"/>
        <elementParameter field="TEXT" name="DBNAME" value="&quot;jaffle_shop&quot;"/>
        <elementParameter field="TEXT" name="TABLE" value="&quot;payment_summary&quot;"/>
        <elementParameter field="CLOSED_LIST" name="ACTION_ON_TABLE" value="DROP_CREATE"/>
        <elementParameter field="CLOSED_LIST" name="ACTION_ON_DATA" value="INSERT"/>
        <metadata connector="FLOW" name="tMysqlOutput_1">
          <column name="payment_method" nullable="true" length="50" type="id_String"/>
          <column name="total_amount" nullable="true" type="id_Double"/>
          <column name="transaction_count" nullable="true" type="id_Long"/>
        </metadata>
      </node>

      <!-- CONNECTIONS -->
      <connection connectorName="FLOW" label="row1" lineStyle="0"
                  metaname="tMysqlInput_1"
                  source="tMysqlInput_1" target="tMap_1"/>
      <connection connectorName="FLOW" label="out1" lineStyle="0"
                  metaname="out1"
                  source="tMap_1" target="tAggregateRow_1"/>
      <connection connectorName="FLOW" label="row3" lineStyle="0"
                  metaname="tAggregateRow_1"
                  source="tAggregateRow_1" target="tMysqlOutput_1"/>

    </process>
  </talendfile:ProcessItem>
</xmi:XMI>
